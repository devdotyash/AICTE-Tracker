// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  emailVerified DateTime?
  image     String?
  username  String?
  name      String?
  googleId  String?  @unique
  accessToken String?
  refreshToken String?
  expiresAt   DateTime?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

